# Decision Model API Configurations
# Copy this file to .env and fill in your keys.

# Google Gemini Decision Model API (gemini-decision-1)
# Supports either GEMINI_API_KEY or X-goog-api-key
GEMINI_API_KEY=your_google_decision_api_key_here
GEMINI_DECISION_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/decisions
GEMINI_DECISION_MODEL=gemini-decision-1
GEMINI_PROXY=http://127.0.0.1:10809

# Local AnyJev Gateway (infra/anyjev/docker-compose.yml)
ANYJEV_ENDPOINT=http://127.0.0.1:8100/v1/decide
ANYJEV_VLLM_ENDPOINT=http://127.0.0.1:8000/v1
ANYJEV_MODEL=tacit-9b

# Local Kev-9B Server (infra/kev/docker-compose.yml)
KEV_ENDPOINT=http://127.0.0.1:8009/v1/systemone
KEV_MODEL=kev-latest
KEV_CHECKPOINT_DIR=/srv/models/jaredpalmer/kev-9b
